.claude/

# Python bytecode from the scripts in scripts/
__pycache__/
*.pyc

# Partial cache writes, if a fetch is interrupted mid-write
*.part

# Generated site output
site/
site_preview/

# Raw session transcript dumps. Durable decisions belong in session-notes.md
# or the relevant doc, not in a verbatim log.
session-*.md
!session-notes.md
